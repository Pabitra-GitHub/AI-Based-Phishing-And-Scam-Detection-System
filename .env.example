# Application Environment
APP_ENV=development
APP_NAME="PhishGuard AI"
DEBUG=true

# Server Configuration
HOST=127.0.0.1
PORT=8000

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite:///./app.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/phishguard

# Security & JWT
JWT_SECRET_KEY=development-super-secret-key-change-in-production-32bytesmin
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Machine Learning
ML_MODEL_PATH=ml/models/phishing_model.joblib
ML_METADATA_PATH=ml/models/model_metadata.json

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Rate Limiting
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_SCAN_PER_MINUTE=60
